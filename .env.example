# Postgres connection string (e.g. from Neon: https://neon.tech). Neon gives you both a
# pooled and a direct connection string -- use the pooled one here for the app itself.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Required for live spreads/scores. Get a key at https://the-odds-api.com/
# Free tier is sufficient for 3 users checking a few times a week.
ODDS_API_KEY=""

# Set to "1" to use the built-in mock odds/scores provider instead of calling The Odds API.
# Useful for demoing the draft/scoring flow end-to-end without a real key.
USE_MOCK_ODDS=""

# A long random string, only needed if you want to (re-)run the one-time database setup
# (seed + historical import) via POST /api/admin/setup -- e.g. from an environment that can
# reach the deployed app but not the database directly. Pick one with `openssl rand -hex 32`.
# Leave unset in normal operation; the endpoint refuses to run without it.
ADMIN_SETUP_TOKEN=""
