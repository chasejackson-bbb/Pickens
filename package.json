{
  "name": "pickens-pickem",
  "version": "1.0.0",
  "private": true,
  "description": "NFL against-the-spread draft pick'em for Blake, Jay, and Chase",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "prisma migrate deploy && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx scripts/seed.ts",
    "import:legacy": "tsx scripts/import-legacy.ts",
    "sync:odds": "tsx scripts/sync-odds.ts",
    "sync:scores": "tsx scripts/sync-scores.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "swr": "^2.2.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
